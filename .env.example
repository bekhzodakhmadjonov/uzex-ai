# Copy to .env and fill in. A Gemini key is required; Claude is optional and not used by default.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
UZEX_PROVIDER=gemini
# Writes the SQL. Benchmark results and reasoning are in the architecture document.
UZEX_GEMINI_MODEL=gemini-3.8-flash
# Used only when the main model returns errors.
UZEX_GEMINI_FALLBACK=gemini-3.5-flash
# Independently re-derives each answer. Leave empty to turn the cross-check off.
UZEX_GEMINI_VERIFY=gemini-3.5-flash-lite
# Writes the answer template. Cannot affect any number or name, so the cheapest model is enough.
UZEX_GEMINI_MODEL_COMPOSE=gemini-3.1-flash-lite
UZEX_RATE_CLIENT=20
UZEX_RATE_GLOBAL=60
DOMAIN=uzex-ai.duckdns.org
# UZEX_FAKE_LLM=1   # offline demo without any API key
