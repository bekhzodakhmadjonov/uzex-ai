# copy to .env and fill in. At least one key is required.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# provider order: primary,fallback  (default: gemini first if both keys exist)
UZEX_PROVIDER=gemini,claude
# UZEX_GEMINI_MODEL=              # SQL rejasi uchun; bo‘sh qolsa eng yangi Pro avtomatik tanlanadi
# UZEX_GEMINI_MODEL_COMPOSE=      # javob matni uchun arzon Flash (masalan gemini-2.5-flash); bo‘sh qolsa Pro ishlatiladi
UZEX_MODEL=claude-opus-5-5
UZEX_SQL_EFFORT=medium
UZEX_ANSWER_EFFORT=low
DOMAIN=uzex-ai.duckdns.org
# UZEX_FAKE_LLM=1   # offline demo without any API key
